#!/usr/bin/env python3
"""Ask the Kimi-K3 pod a question. Streams the answer to stdout.

Usage: kimi "question"      or      echo "question" | kimi
       kimi --think ...      also prints the reasoning (to stderr)
Config: ~/.config/kimi-pod/{url,api_key}
"""
import json, os, sys, urllib.request

cfg = os.path.expanduser("~/.config/kimi-pod")
url = open(f"{cfg}/url").read().strip()
key = open(f"{cfg}/api_key").read().strip()

args = sys.argv[1:]
think = "--think" in args
args = [a for a in args if a != "--think"]
prompt = " ".join(args) if args else sys.stdin.read()

req = urllib.request.Request(
    f"{url}/v1/chat/completions",
    data=json.dumps({
        "messages": [{"role": "user", "content": prompt}],
        "stream": True,
        "max_tokens": 8192,
    }).encode(),
    # Cloudflare in front of the Runpod proxy 403s urllib's default User-Agent
    headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json",
             "User-Agent": "kimi-cli/1.0"},
)
with urllib.request.urlopen(req, timeout=600) as r:
    for line in r:
        line = line.decode().strip()
        if not line.startswith("data: ") or line == "data: [DONE]":
            continue
        delta = json.loads(line[6:])["choices"][0].get("delta", {})
        if think and delta.get("reasoning_content"):
            sys.stderr.write(delta["reasoning_content"]); sys.stderr.flush()
        if delta.get("content"):
            sys.stdout.write(delta["content"]); sys.stdout.flush()
print()
